<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/commandcontainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="Command"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/workdircontainer"
        >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/command"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textPersonName"
            android:text=""
            android:typeface="monospace"
            />
    </com.google.android.material.textfield.TextInputLayout>

    <Switch
        android:id="@+id/useshell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Use Shell"
        app:layout_constraintEnd_toStartOf="@+id/runpip"
        app:layout_constraintStart_toStartOf="@+id/commandcontainer"
        app:layout_constraintTop_toBottomOf="@+id/commandcontainer" />
    <Switch
        android:id="@+id/runpip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Run pip"
        app:layout_constraintEnd_toEndOf="@+id/commandcontainer"
        app:layout_constraintStart_toEndOf="@+id/useshell"
        app:layout_constraintTop_toBottomOf="@+id/commandcontainer" />

    <Button
        android:id="@+id/run"
        style="@style/secondary_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Run"
        app:layout_constraintEnd_toStartOf="@+id/stop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/useshell" />

    <Button
        android:id="@+id/stop"
        style="@style/secondary_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/run"
        app:layout_constraintTop_toBottomOf="@+id/useshell" />

    <HorizontalScrollView android:layout_width="0dp"
                          android:layout_height="0dp"
                          android:layout_marginBottom="8dp"
                          android:layout_marginEnd="8dp" android:layout_marginStart="8dp"
                          android:layout_marginTop="20dp" android:background="@color/terminal_bg"
                          app:layout_constraintBottom_toBottomOf="parent"
                          app:layout_constraintEnd_toEndOf="parent"
                          app:layout_constraintHorizontal_bias="0.0"
                          app:layout_constraintStart_toStartOf="parent"
                          app:layout_constraintTop_toBottomOf="@+id/run"
                          app:layout_constraintVertical_bias="0.0">
        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:text=""
                android:typeface="monospace"
                android:scrollHorizontally="true"
                android:textIsSelectable="true"/>
        </ScrollView>
    </HorizontalScrollView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/workdircontainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="start"
        android:hint="Working directory"
        app:layout_constraintBottom_toTopOf="@+id/commandcontainer"
        app:layout_constraintEnd_toStartOf="@+id/browse"
        app:layout_constraintStart_toStartOf="@+id/commandcontainer"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workdir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textPersonName"
            android:text=""
            android:typeface="monospace"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button
        android:id="@+id/browse"
        style="@style/secondary_btn_tiny"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:text="···"
        android:textAlignment="center"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/commandcontainer"
        app:layout_constraintEnd_toEndOf="@+id/commandcontainer"
        app:layout_constraintTop_toTopOf="@+id/workdircontainer"
        app:layout_constraintDimensionRatio="H,2:3"/>

</androidx.constraintlayout.widget.ConstraintLayout>
